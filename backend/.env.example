# Copy to .env for local dev. On Render, set these as the Web Service's
# Environment Variables instead — never commit a real .env file.

# CHECKPOINT 2 (multi-tenant): same free Atlas cluster as Checkpoint 1 and
# the original Streamlit app, but this process never opens ONE fixed
# database. Which database it uses is decided per-request (see db.py /
# app.py's TenantContextMiddleware) from the company code entered at
# login. DB_NAME below is only the fallback used when no tenant is set —
# effectively unused in normal operation, but ensure_indexes() touches it
# on boot, so give it a harmless name of its own.
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.ua3bzky.mongodb.net
DB_NAME=lms_fallback_unused

# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# Use a DIFFERENT value than Checkpoint 1's JWT_SECRET — a token minted by
# one deployment should never be valid on the other.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# No SEED_ADMIN_* here — Checkpoint 2 has no single global admin. Each
# client company gets its own first admin through the Super Admin console
# (POST /api/platform/tenants) when they're onboarded.

# D'siar Tech's OWN operator account — created once, on first boot, if no
# Super Admin exists yet. Log in at /platform/login with these. Set these
# only on the very first deploy (or when rotating the password); they're
# never touched again after the account exists.
PLATFORM_SUPER_ADMIN_EMAIL=you@dsiar.com
PLATFORM_SUPER_ADMIN_PASSWORD=change-this-password
PLATFORM_SUPER_ADMIN_NAME=D'siar Tech

DIGITALSAMBA_TEAM_ID=
DIGITALSAMBA_DEVELOPER_KEY=

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
